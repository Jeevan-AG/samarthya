---
import "../styles/global.css";
import Navbar from "../components/Navbar";
import Preloader from "../components/Preloader";
import SiteCursor from "../components/SiteCursor";
import SmoothScroll from "../components/SmoothScroll";

interface Props {
  title: string;
  description?: string;
  current?: string;
}

const links = [
  { href: "/", label: "Home" },
  { href: "/#about", label: "About" },
  { href: "/faculty", label: "Faculty" },
  { href: "/team", label: "Team" },
  { href: "/events", label: "Events" },
];

const { title, description, current = "/" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
  </head>
  <body class="grain scanlines bg-void text-paper relative min-h-[100dvh]">
    <a href="#content" class="skip-link">Skip to content</a>

    <!-- Universal Background matching Homepage across ALL pages -->
    <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden bg-[radial-gradient(circle_at_center,transparent_45%,rgba(3,6,13,0.85)_100%)]" aria-hidden="true"></div>
    <div class="pointer-events-none fixed inset-0 z-0 grid-floor opacity-40" aria-hidden="true"></div>

    <Preloader client:load />
    <SiteCursor client:load />
    <SmoothScroll client:load />
    <Navbar client:load pathname={current} />
    <main id="content" class="relative z-10">
      <slot />
    </main>
    <footer class="relative z-10 border-t border-line/25 bg-transparent" aria-label="Site footer">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan/25 to-transparent"></div>
      <div class="mx-auto grid max-w-[1400px] gap-12 px-5 py-16 md:grid-cols-12 lg:px-8">
        <div class="md:col-span-5">
          <a href="/" class="mb-4 inline-flex items-center gap-3">
            <img src="/logo.svg" alt="" class="h-10 w-10 object-contain" />
            <span class="font-display text-2xl tracking-[0.16em]">SAMARTHYA</span>
          </a>
          <p class="max-w-sm text-sm leading-relaxed text-mute">
            Electronics and Communication Department
          </p>
        </div>
        <div class="md:col-span-3">
          <p class="mb-4 font-mono text-[11px] uppercase tracking-[0.22em] text-faint">Navigate</p>
          <ul class="space-y-2">
            {links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={["text-sm text-mute hover:text-cyan", current === link.href && "text-cyan"]}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="md:col-span-4">
          <p class="mb-4 font-mono text-[11px] uppercase tracking-[0.22em] text-faint">Room No 1403</p>
          <div class="flex items-center gap-5 pt-1">
            <a
              href="https://instagram.com/samarthya_sjec?cplk=aGhxNXl2YTg5ZzV0"
              target="_blank"
              rel="noopener noreferrer"
              class="text-mute hover:text-cyan transition-all duration-200 hover:scale-110 inline-flex items-center justify-center"
              aria-label="Instagram"
            >
              <svg class="h-7 w-7 sm:h-8 sm:w-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
            <a
              href="https://www.linkedin.com/in/samarthyasjec?trk=blended-typeahead"
              target="_blank"
              rel="noopener noreferrer"
              class="text-mute hover:text-cyan transition-all duration-200 hover:scale-110 inline-flex items-center justify-center"
              aria-label="LinkedIn"
            >
              <svg class="h-7 w-7 sm:h-8 sm:w-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12" rx="0.5"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </a>
          </div>
        </div>
      </div>
      <div class="mx-auto flex max-w-[1400px] flex-col gap-3 border-t border-line/30 px-5 py-6 text-xs text-faint sm:flex-row sm:items-center sm:justify-between lg:px-8">
        <p>© 2026 SAMARTHYA — ECE Department Club</p>
      </div>
    </footer>
  </body>
</html>
