---
import { Image } from "astro:assets";
import gal1 from "../assets/pics/gallery/gallery_1.webp";
import gal2 from "../assets/pics/gallery/gallery_2.webp";
import gal3 from "../assets/pics/gallery/gallery_3.webp";
import gal4 from "../assets/pics/gallery/gallery_4.webp";
import gal5 from "../assets/pics/gallery/gallery_5.webp";
import gal6 from "../assets/pics/gallery/gallery_6.webp";
import gal7 from "../assets/pics/gallery/gallery_7.webp";
import gal8 from "../assets/pics/gallery/gallery_8.webp";
import gal9 from "../assets/pics/gallery/gallery_9.webp";
import cc2_1 from "../assets/pics/events/circuit_craft_2/circuit_craft_2_1.webp";
import cc2_3 from "../assets/pics/events/circuit_craft_2/circuit_craft_2_3.webp";
import cc2_4 from "../assets/pics/events/circuit_craft_2/circuit_craft_2_4.webp";
import cc1_1 from "../assets/pics/events/circuit_craft_1/circuit_craft_1_1.webp";
import cc1_2 from "../assets/pics/events/circuit_craft_1/circuit_craft_1_2.webp";
import ev8 from "../assets/pics/ev8_sharp.webp";

// 3 Curated Columns for continuous parallax flow
const col1 = [
  { img: gal1, aspect: "aspect-[16/10]" },
  { img: cc2_1, aspect: "aspect-[4/3]" },
  { img: gal4, aspect: "aspect-[16/10]" },
  { img: cc1_1, aspect: "aspect-[4/3]" },
  { img: gal7, aspect: "aspect-[16/10]" },
];

const col2 = [
  { img: gal2, aspect: "aspect-[4/3]" },
  { img: gal5, aspect: "aspect-[16/10]" },
  { img: cc2_3, aspect: "aspect-[4/3]" },
  { img: gal8, aspect: "aspect-[16/10]" },
  { img: ev8, aspect: "aspect-[4/3]" },
];

const col3 = [
  { img: gal3, aspect: "aspect-[16/10]" },
  { img: cc2_4, aspect: "aspect-[4/3]" },
  { img: gal6, aspect: "aspect-[16/10]" },
  { img: cc1_2, aspect: "aspect-[4/3]" },
  { img: gal9, aspect: "aspect-[16/10]" },
];

// 2 Curated Columns for mobile continuous parallax flow (dual-column stream)
const mobileCol1 = [
  { img: gal1, aspect: "aspect-[16/10]" },
  { img: cc2_1, aspect: "aspect-[4/3]" },
  { img: gal4, aspect: "aspect-[16/10]" },
  { img: gal2, aspect: "aspect-[4/3]" },
  { img: gal7, aspect: "aspect-[16/10]" },
  { img: cc2_3, aspect: "aspect-[4/3]" },
  { img: gal9, aspect: "aspect-[16/10]" },
  { img: cc1_1, aspect: "aspect-[4/3]" },
];

const mobileCol2 = [
  { img: gal5, aspect: "aspect-[16/10]" },
  { img: cc1_2, aspect: "aspect-[4/3]" },
  { img: gal3, aspect: "aspect-[16/10]" },
  { img: ev8, aspect: "aspect-[4/3]" },
  { img: gal8, aspect: "aspect-[16/10]" },
  { img: cc2_4, aspect: "aspect-[4/3]" },
  { img: gal6, aspect: "aspect-[16/10]" },
];
---

<div class="parallax-flow-root relative w-full overflow-hidden py-4 sm:py-6 select-none" id="parallax-flow-root">
  <!-- Subtle ambient lighting safely centered so it never creates sharp cutoffs at edges -->
  <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 -z-10 h-[500px] w-full max-w-[800px] rounded-full bg-cyan/[0.04] blur-[140px]"></div>

  <!-- Mobile Dual-Column Parallax Grid (< md) -->
  <div class="grid grid-cols-2 gap-3 sm:gap-4 md:hidden items-start">
    <!-- Mobile Column 1 (Speed: +0.05) -->
    <div class="parallax-col flex flex-col gap-3 sm:gap-4 will-change-transform" data-speed="0.05">
      {mobileCol1.map((item) => (
        <div class="group relative overflow-hidden rounded-xl sm:rounded-2xl border border-white/10 bg-void/60 shadow-xl transition-all duration-300 hover:border-cyan/50 hover:shadow-[0_0_25px_rgba(0,251,248,0.25)]">
          <div class={`relative overflow-hidden ${item.aspect} w-full`}>
            <Image
              src={item.img}
              alt="SAMARTHYA Workshop Photo"
              width={600}
              height={400}
              format="webp"
              quality={82}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-center brightness-[0.92] contrast-[1.04] transition-all duration-500 ease-out group-hover:scale-105 group-hover:brightness-105"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void/70 via-transparent to-transparent opacity-40"></div>
          </div>
        </div>
      ))}
    </div>

    <!-- Mobile Column 2 (Speed: -0.05 with staggered top) -->
    <div class="parallax-col flex flex-col gap-3 sm:gap-4 mt-6 sm:mt-8 will-change-transform" data-speed="-0.05">
      {mobileCol2.map((item) => (
        <div class="group relative overflow-hidden rounded-xl sm:rounded-2xl border border-white/10 bg-void/60 shadow-xl transition-all duration-300 hover:border-cyan/50 hover:shadow-[0_0_25px_rgba(0,251,248,0.25)]">
          <div class={`relative overflow-hidden ${item.aspect} w-full`}>
            <Image
              src={item.img}
              alt="SAMARTHYA Workshop Photo"
              width={600}
              height={400}
              format="webp"
              quality={82}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-center brightness-[0.92] contrast-[1.04] transition-all duration-500 ease-out group-hover:scale-105 group-hover:brightness-105"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void/70 via-transparent to-transparent opacity-40"></div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Desktop 3-Column Parallax Grid (>= md) -->
  <div class="hidden md:grid md:grid-cols-3 gap-5 md:gap-6 lg:gap-8 items-start">
    
    <!-- Column 1 (Speed: 0.06) -->
    <div class="parallax-col flex flex-col gap-5 md:gap-6 lg:gap-8 will-change-transform" data-speed="0.06">
      {col1.map((item) => (
        <div class="group relative overflow-hidden rounded-2xl sm:rounded-3xl border border-white/10 bg-void/60 shadow-2xl transition-all duration-500 hover:border-cyan/50 hover:shadow-[0_0_35px_rgba(0,251,248,0.25)]">
          <div class={`relative overflow-hidden ${item.aspect} w-full`}>
            <Image
              src={item.img}
              alt="SAMARTHYA Workshop Photo"
              width={800}
              height={500}
              format="webp"
              quality={82}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-center brightness-[0.92] contrast-[1.04] transition-all duration-700 ease-out group-hover:scale-105 group-hover:brightness-105"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void/75 via-transparent to-transparent opacity-40 group-hover:opacity-10 transition-opacity duration-300"></div>
          </div>
        </div>
      ))}
    </div>

    <!-- Column 2 (Speed: -0.07 with dynamic top offset) -->
    <div class="parallax-col flex flex-col gap-5 md:gap-6 lg:gap-8 md:-mt-8 lg:-mt-12 will-change-transform" data-speed="-0.07">
      {col2.map((item) => (
        <div class="group relative overflow-hidden rounded-2xl sm:rounded-3xl border border-white/10 bg-void/60 shadow-2xl transition-all duration-500 hover:border-cyan/50 hover:shadow-[0_0_35px_rgba(0,251,248,0.25)]">
          <div class={`relative overflow-hidden ${item.aspect} w-full`}>
            <Image
              src={item.img}
              alt="SAMARTHYA Workshop Photo"
              width={800}
              height={500}
              format="webp"
              quality={82}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-center brightness-[0.92] contrast-[1.04] transition-all duration-700 ease-out group-hover:scale-105 group-hover:brightness-105"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void/75 via-transparent to-transparent opacity-40 group-hover:opacity-10 transition-opacity duration-300"></div>
          </div>
        </div>
      ))}
    </div>

    <!-- Column 3 (Speed: 0.08) -->
    <div class="parallax-col flex flex-col gap-5 md:gap-6 lg:gap-8 will-change-transform" data-speed="0.08">
      {col3.map((item) => (
        <div class="group relative overflow-hidden rounded-2xl sm:rounded-3xl border border-white/10 bg-void/60 shadow-2xl transition-all duration-500 hover:border-cyan/50 hover:shadow-[0_0_35px_rgba(0,251,248,0.25)]">
          <div class={`relative overflow-hidden ${item.aspect} w-full`}>
            <Image
              src={item.img}
              alt="SAMARTHYA Workshop Photo"
              width={800}
              height={500}
              format="webp"
              quality={82}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-center brightness-[0.92] contrast-[1.04] transition-all duration-700 ease-out group-hover:scale-105 group-hover:brightness-105"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void/75 via-transparent to-transparent opacity-40 group-hover:opacity-10 transition-opacity duration-300"></div>
          </div>
        </div>
      ))}
    </div>

  </div>
</div>

<script>
  function initParallaxFlow() {
    const container = document.getElementById("parallax-flow-root");
    if (!container) return;

    const cols = container.querySelectorAll<HTMLElement>(".parallax-col");
    let ticking = false;

    function updateParallax() {
      if (!container) return;
      const rect = container.getBoundingClientRect();
      const viewportHeight = window.innerHeight || document.documentElement.clientHeight;

      if (rect.top < viewportHeight + 100 && rect.bottom > -100) {
        const centerY = (rect.top + rect.height / 2) - (viewportHeight / 2);
        const isMobile = window.innerWidth < 768;
        const speedMultiplier = isMobile ? 0.75 : 1.0;
        
        cols.forEach((col) => {
          if (col.offsetParent === null) return;
          const speed = parseFloat(col.getAttribute("data-speed") || "0");
          const offset = centerY * speed * speedMultiplier;
          col.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0)`;
        });
      }
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(updateParallax);
        ticking = true;
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    window.addEventListener("touchmove", onScroll, { passive: true });

    if ((window as any).lenis) {
      (window as any).lenis.on("scroll", onScroll);
    }

    updateParallax();
  }

  initParallaxFlow();
  document.addEventListener("astro:page-load", initParallaxFlow);
</script>
