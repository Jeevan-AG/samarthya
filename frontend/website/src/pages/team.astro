---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import RevealOnView from "../components/RevealOnView";
import TiltCard from "../components/TiltCard";
import team from "../data/team.json";

// Dynamically load all team portrait images in native WebP with full Astro optimization
const teamImages = import.meta.glob<{ default: ImageMetadata }>("../assets/pics/team/*.webp", { eager: true });

// Group team members by category
const categories = [
  {
    name: "Executive Leadership",
    tag: "Board of Directors",
    desc: "Guiding the strategic vision, governance, and academic alignment of the society.",
    members: team.filter((m) => m.category === "Executive Leadership")
  },
  {
    name: "Technical & Engineering Leads",
    tag: "Domain Architects",
    desc: "Spearheading embedded hardware development, web architecture, and circuit design workshops.",
    members: team.filter((m) => m.category === "Technical & Development")
  },
  {
    name: "Secretariat & Operations",
    tag: "Club Operations",
    desc: "Managing organizational workflows, event logistics, and departmental communications.",
    members: team.filter((m) => m.category === "Secretariat & Operations")
  },
  {
    name: "Core Leads & Media",
    tag: "Team Leads & Creative",
    desc: "Coordinating student cohorts, workshop fabrication, and visual branding.",
    members: team.filter((m) => m.category === "Team Leads & Media")
  },
  {
    name: "Core Team Members",
    tag: "Engineering Force",
    desc: "Hands-on contributors driving workshop execution, hardware testbenches, and lab innovation.",
    members: team.filter((m) => m.category === "Core Team")
  }
];
---

<BaseLayout
  current="/team"
  title="Office Bearers & Core Team | SAMARTHYA"
  description="Meet the student office bearers, domain leads, and core team behind SAMARTHYA ECE technical society."
>
  <section class="relative mx-auto max-w-[1440px] px-5 pb-28 pt-32 lg:px-8">
    
    <!-- Hero Header -->
    <div class="relative max-w-3xl mb-16 sm:mb-20">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full font-mono text-[11px] uppercase tracking-[0.24em] bg-cyan/10 text-cyan border border-cyan/25 mb-4">
        <span class="h-2 w-2 rounded-full bg-cyan animate-pulse"></span>
        Student Leadership &amp; Crew
      </div>
      <h1 class="font-display text-5xl sm:text-7xl lg:text-8xl tracking-tight text-paper">
        Office Bearers &amp; Core Team
      </h1>
      <p class="mt-6 text-base sm:text-lg leading-relaxed text-mute">
        The student engineering collective driving SAMARTHYA's hands-on laboratory research, workshops, circuit fabrication, and technical symposiums.
      </p>
    </div>

    <!-- Team Categories & Hierarchy -->
    <div class="space-y-20 lg:space-y-28">
      {categories.map((cat, catIdx) => (
        <section class="relative" aria-labelledby={`category-${catIdx}`}>
          <!-- Category Header Bar -->
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-line/50 pb-5 mb-10">
            <div>
              <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-cyan font-medium">
                {cat.tag}
              </span>
              <h2 id={`category-${catIdx}`} class="font-display text-3xl sm:text-4xl text-paper mt-1">
                {cat.name}
              </h2>
            </div>
            <p class="max-w-md text-xs sm:text-sm text-mute leading-relaxed font-sans">
              {cat.desc}
            </p>
          </div>

          <!-- Members Grid with perfectly even card heights & proportions -->
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {cat.members.map((member, i) => {
              const imageKey = `../assets/pics/team/${member.image}`;
              const imgMetadata = teamImages[imageKey]?.default;

              return (
                <RevealOnView client:visible delay={i * 45}>
                  <TiltCard client:visible className="h-full">
                    <article class="group relative flex flex-col justify-between h-full rounded-2xl border border-line bg-surface/40 backdrop-blur-sm p-5 transition-all duration-300 hover:border-cyan/50 hover:shadow-[0_0_24px_rgba(0,251,248,0.15)] hover:-translate-y-1.5 overflow-hidden">
                      
                      <!-- Holographic scanning sweep on hover -->
                      <div class="pointer-events-none absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-cyan/8 to-transparent" aria-hidden="true"></div>

                      <!-- Tech Corner Accents -->
                      <div class="pointer-events-none absolute top-2.5 right-2.5 w-2 h-2 border-t border-r border-cyan/20 group-hover:border-cyan/60 transition-colors duration-300" aria-hidden="true"></div>
                      <div class="pointer-events-none absolute bottom-2.5 left-2.5 w-2 h-2 border-b border-l border-cyan/20 group-hover:border-cyan/60 transition-colors duration-300" aria-hidden="true"></div>

                      <div class="relative z-10 flex flex-col flex-1">
                        <!-- Uniform 3:4 Portrait Image Container -->
                        <div class="relative mb-5 overflow-hidden rounded-xl bg-void aspect-[3/4] border border-white/10 group-hover:border-cyan/30 transition-colors duration-300 shadow-inner">
                          {imgMetadata ? (
                            <Image
                              src={imgMetadata}
                              alt={`Portrait of ${member.name}`}
                              width={480}
                              height={640}
                              format="webp"
                              quality={92}
                              loading="lazy"
                              decoding="async"
                              class="h-full w-full object-cover object-top brightness-[0.95] contrast-[1.03] transition-all duration-500 group-hover:scale-105 group-hover:brightness-100"
                            />
                          ) : (
                            <div class="flex h-full w-full items-center justify-center bg-panel font-mono text-xs text-faint">
                              [PHOTO]
                            </div>
                          )}

                          <!-- Ambient Gradient Vignette -->
                          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void/85 via-transparent to-transparent opacity-60 group-hover:opacity-30 transition-opacity duration-300"></div>

                          <!-- Floating Role Badge -->
                          <div class="absolute bottom-2.5 left-2.5 right-2.5">
                            <span class="inline-flex w-full items-center justify-center px-2.5 py-1 rounded-lg font-mono text-[10.5px] uppercase tracking-[0.16em] bg-void/90 text-cyan border border-cyan/35 backdrop-blur-md shadow-md">
                              {member.role}
                            </span>
                          </div>
                        </div>

                        <!-- Member Info with uniform text boxes -->
                        <div class="flex-1 flex flex-col justify-between">
                          <div>
                            <h3 class="font-display text-2xl text-paper transition-colors duration-300 group-hover:text-cyan line-clamp-1">
                              {member.name}
                            </h3>

                            <div class="mt-1 flex items-center gap-2 font-mono text-[11px] text-faint">
                              <span>{member.year}</span>
                              <span>•</span>
                              <span class="text-paper/70">ECE Dept</span>
                            </div>

                            <!-- Specialization Pill -->
                            {member.domain && (
                              <div class="mt-3">
                                <span class="inline-block rounded-md bg-white/[0.04] px-2.5 py-1 font-mono text-[10.5px] text-paper/85 border border-white/10 group-hover:border-cyan/25 transition-colors line-clamp-1">
                                  {member.domain}
                                </span>
                              </div>
                            )}
                          </div>

                          <!-- Bio Description -->
                          <p class="mt-3 text-xs leading-relaxed text-mute line-clamp-2">
                            {member.bio}
                          </p>
                        </div>
                      </div>

                      <!-- Bottom HUD Status -->
                      <div class="relative z-10 mt-5 pt-3 border-t border-line/20 flex items-center justify-between font-mono text-[10px] text-faint">
                        <span>SAMARTHYA</span>
                        <span class="text-cyan/70 group-hover:text-cyan transition-colors">OFFICIAL</span>
                      </div>

                    </article>
                  </TiltCard>
                </RevealOnView>
              );
            })}
          </div>
        </section>
      ))}
    </div>

  </section>
</BaseLayout>
