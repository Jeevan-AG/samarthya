---
import BaseLayout from "../layouts/BaseLayout.astro";
import RevealOnView from "../components/RevealOnView";
import team from "../data/team.json";
---

<BaseLayout
  current="/team"
  title="Core Team | SAMARTHYA"
  description="Student office bearers of SAMARTHYA."
>
  <section class="relative mx-auto max-w-[1400px] px-5 pb-24 pt-32 lg:px-8">
    <p class="relative font-mono text-[11px] uppercase tracking-[0.32em] text-cyan">Student crew</p>
    <h1 class="relative mt-4 font-display text-6xl md:text-8xl">Core team</h1>
    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {team.map((member, i) => (
        <RevealOnView client:visible delay={i * 40}>
          <article class="hud-border p-6 rounded-2xl">
            <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-cyan">{member.role}</p>
            <h2 class="mt-3 font-display text-3xl leading-none">{member.name}</h2>
            <p class="mt-2 text-sm text-mute">{member.year} · ECE</p>
          </article>
        </RevealOnView>
      ))}
    </div>
  </section>
</BaseLayout>
