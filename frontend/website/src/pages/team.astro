---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import RevealOnView from "../components/RevealOnView";
import TiltCard from "../components/TiltCard";
import team from "../data/team.json";

// Dynamically load all team portrait images in native WebP with full Astro optimization
const teamImages = import.meta.glob<{ default: ImageMetadata }>("../assets/pics/team/*.webp", { eager: true });
---

<BaseLayout
  current="/team"
  title="Core Team | SAMARTHYA"
  description="Meet the core team behind SAMARTHYA ECE technical society."
>
  <section class="relative mx-auto max-w-[1440px] px-5 pb-24 pt-28 lg:pt-32 lg:px-8">
    
    <!-- Hero Header -->
    <div class="mb-10 sm:mb-14">
      <h1 class="font-display text-5xl sm:text-7xl lg:text-8xl tracking-tight text-paper">
        Core Team
      </h1>
    </div>

    <!-- Members Grid -->
    <div class="grid gap-5 sm:gap-6 grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {team.map((member, i) => {
        const imageKey = `../assets/pics/team/${member.image}`;
        const imgMetadata = teamImages[imageKey]?.default;

        const scaleVal = member.scale 
          ? (typeof member.scale === 'number' ? member.scale : parseFloat(member.scale.replace(/[^0-9.]/g, '')) / 100 || member.scale)
          : 1.1;

        return (
          <RevealOnView client:visible delay={i * 30}>
            <TiltCard client:visible className="h-full">
              <article class="group relative flex flex-col justify-between h-full rounded-2xl border border-line bg-surface/50 backdrop-blur-md overflow-hidden transition-all duration-300 hover:border-cyan/50 hover:shadow-[0_12px_30px_rgba(0,0,0,0.6),0_0_24px_rgba(0,251,248,0.15)] hover:-translate-y-1.5">
                
                {/* Image Frame */}
                <div class="relative aspect-square w-full overflow-hidden bg-void/80 border-b border-line/40">
                  {imgMetadata ? (
                    <Image
                      src={imgMetadata}
                      alt={`Portrait of ${member.name}`}
                      width={500}
                      height={500}
                      format="webp"
                      quality={88}
                      loading="lazy"
                      decoding="async"
                      class="portrait-grayscale h-full w-full object-cover group-hover:brightness-105"
                      style={{
                        objectPosition: member.objectPosition || 'center 25%',
                        transform: `scale(${scaleVal})`
                      }}
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-panel font-mono text-xs text-faint">
                      [PHOTO]
                    </div>
                  )}

                  {/* Ambient Gradient Overlay */}
                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-80 group-hover:opacity-40 transition-opacity duration-300"></div>
                </div>

                {/* Info Container */}
                <div class="p-4 sm:p-5 flex items-center justify-between gap-2 flex-1">
                  <div class="min-w-0">
                    <h3 class="font-display text-lg sm:text-xl text-paper transition-colors duration-300 group-hover:text-cyan truncate">
                      {member.name}
                    </h3>

                    {member.role && (
                      <p class="mt-0.5 font-mono text-[11px] uppercase tracking-[0.12em] text-cyan/90 font-medium truncate">
                        {member.role}
                      </p>
                    )}
                  </div>

                  {member.linkedin && (
                    <a
                      href={member.linkedin}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-mute hover:text-cyan hover:scale-115 transition-all p-1 flex-shrink-0"
                      aria-label={`${member.name}'s LinkedIn`}
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                        <rect x="2" y="9" width="4" height="12" rx="0.5" />
                        <circle cx="4" cy="4" r="2" />
                      </svg>
                    </a>
                  )}
                </div>

                {/* Accent Bar */}
                <div class="absolute bottom-0 left-0 right-0 h-[2px] bg-cyan scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left" />

              </article>
            </TiltCard>
          </RevealOnView>
        );
      })}
    </div>

  </section>
</BaseLayout>

<style>
  :global(main img),
  :global(section img),
  :global(div img) {
    filter: grayscale(100%) !important;
    transition: filter 0.3s ease-in-out !important;
  }

  :global(main img:hover),
  :global(section img:hover),
  :global(div:hover > img),
  :global(a:hover img) {
    filter: grayscale(0%) !important;
  }

  :global(nav img),
  :global(header img),
  :global(.logo img) {
    filter: none !important;
  }
</style>