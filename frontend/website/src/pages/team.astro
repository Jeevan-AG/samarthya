---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import RevealOnView from "../components/RevealOnView";
import TiltCard from "../components/TiltCard";
import team from "../data/team.json";

// Dynamically load all team portrait images in native WebP with full Astro optimization
const teamImages = import.meta.glob<{ default: ImageMetadata }>("../assets/pics/team/*.webp", { eager: true });

// Group team members by category
const categories = [
  {
    name: "Executive Leadership",
    tag: "Board of Directors",
    desc: "Guiding the strategic vision, governance, and academic alignment of the society.",
    members: team.filter((m) => m.category === "Executive Leadership")
  },
  {
    name: "Technical & Engineering Leads",
    tag: "Domain Architects",
    desc: "Spearheading embedded hardware development, web architecture, and circuit design workshops.",
    members: team.filter((m) => m.category === "Technical & Development")
  },
  {
    name: "Secretariat & Operations",
    tag: "Club Operations",
    desc: "Managing organizational workflows, event logistics, and departmental communications.",
    members: team.filter((m) => m.category === "Secretariat & Operations")
  },
  {
    name: "Core Leads & Media",
    tag: "Team Leads & Creative",
    desc: "Coordinating student cohorts, workshop fabrication, and visual branding.",
    members: team.filter((m) => m.category === "Team Leads & Media")
  },
  {
    name: "Core Team Members",
    tag: "Engineering Force",
    desc: "Hands-on contributors driving workshop execution, hardware testbenches, and lab innovation.",
    members: team.filter((m) => m.category === "Core Team")
  }
];
---

<BaseLayout
  current="/team"
  title="Office Bearers & Core Team | SAMARTHYA"
  description="Meet the student office bearers, domain leads, and core team behind SAMARTHYA ECE technical society."
>
  <section class="relative mx-auto max-w-[1440px] px-5 pb-28 pt-32 lg:px-8">
    
    <!-- Hero Header -->
    <div class="relative max-w-3xl mb-16 sm:mb-20">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full font-mono text-[11px] uppercase tracking-[0.24em] bg-cyan/10 text-cyan border border-cyan/25 mb-4">
        <span class="h-2 w-2 rounded-full bg-cyan animate-pulse"></span>
        Student Leadership &amp; Crew
      </div>
      <h1 class="font-display text-5xl sm:text-7xl lg:text-8xl tracking-tight text-paper">
        Office Bearers &amp; Core Team
      </h1>
      <p class="mt-6 text-base sm:text-lg leading-relaxed text-mute">
        The student engineering collective driving SAMARTHYA's hands-on laboratory research, workshops, circuit fabrication, and technical symposiums.
      </p>
    </div>

    <!-- Team Categories & Hierarchy -->
    <div class="space-y-20 lg:space-y-28">
      {categories.map((cat, catIdx) => (
        <section class="relative" aria-labelledby={`category-${catIdx}`}>
          <!-- Category Header Bar -->
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-line/50 pb-5 mb-10">
            <div>
              <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-cyan font-medium">
                {cat.tag}
              </span>
              <h2 id={`category-${catIdx}`} class="font-display text-3xl sm:text-4xl text-paper mt-1">
                {cat.name}
              </h2>
            </div>
            <p class="max-w-md text-xs sm:text-sm text-mute leading-relaxed font-sans">
              {cat.desc}
            </p>
          </div>

          <!-- Members Grid with Website1 Card Style -->
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {cat.members.map((member, i) => {
              const imageKey = `../assets/pics/team/${member.image}`;
              const imgMetadata = teamImages[imageKey]?.default;

              return (
                <RevealOnView client:visible delay={i * 45}>
                  <TiltCard client:visible className="h-full">
                    <article class="group relative flex flex-col justify-between h-full rounded-2xl border border-line bg-surface/50 backdrop-blur-md overflow-hidden transition-all duration-300 hover:border-cyan/50 hover:shadow-[0_12px_30px_rgba(0,0,0,0.6),0_0_24px_rgba(0,251,248,0.15)] hover:-translate-y-1.5">
                      
                      {/* Image Frame with Website1 Zoom & Gradient Overlay */}
                      <div class="relative aspect-square w-full overflow-hidden bg-void/80">
                        {imgMetadata ? (
                          <Image
                            src={imgMetadata}
                            alt={`Portrait of ${member.name}`}
                            width={500}
                            height={500}
                            format="webp"
                            quality={88}
                            loading="lazy"
                            decoding="async"
                            class="h-full w-full object-cover object-top brightness-[0.95] contrast-[1.03] transition-transform duration-700 ease-out group-hover:scale-108 group-hover:brightness-105"
                          />
                        ) : (
                          <div class="flex h-full w-full items-center justify-center bg-panel font-mono text-xs text-faint">
                            [PHOTO]
                          </div>
                        )}

                        <!-- Ambient Gradient Overlay -->
                        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-80 group-hover:opacity-40 transition-opacity duration-300"></div>

                        <!-- Role Pill Tag on Image Top -->
                        <div class="absolute top-3 left-3">
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full font-mono text-[10px] uppercase tracking-[0.16em] bg-void/85 text-cyan border border-cyan/35 backdrop-blur-md shadow-md">
                            {member.role}
                          </span>
                        </div>
                      </div>

                      {/* Info Container */}
                      <div class="p-5 flex flex-col justify-between flex-1">
                        <div>
                          <h3 class="font-display text-xl sm:text-2xl text-paper transition-colors duration-300 group-hover:text-cyan line-clamp-1">
                            {member.name}
                          </h3>
                          
                          <div class="mt-1 flex items-center gap-2 font-mono text-[11px] text-cyan/90 font-medium tracking-wider uppercase">
                            <span>{member.year}</span>
                            <span>•</span>
                            <span>{member.semester || "ECE"}</span>
                          </div>

                          {member.domain && (
                            <p class="mt-2 text-xs font-mono text-paper/70 line-clamp-1">
                              {member.domain}
                            </p>
                          )}

                          <p class="mt-3 text-xs leading-relaxed text-mute line-clamp-2 font-sans">
                            {member.bio}
                          </p>
                        </div>

                        <!-- Bottom Tag -->
                        <div class="mt-4 pt-3 border-t border-line/30 flex items-center justify-between font-mono text-[10px] text-faint">
                          <span>SAMARTHYA</span>
                          <span class="text-cyan/70 group-hover:text-cyan transition-colors uppercase">SJEC ECE</span>
                        </div>
                      </div>

                      {/* Bottom Accent Bar from Website1 */}
                      <div class="absolute bottom-0 left-0 right-0 h-[2.5px] bg-cyan scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left" />

                    </article>
                  </TiltCard>
                </RevealOnView>
              );
            })}
          </div>
        </section>
      ))}
    </div>

  </section>
</BaseLayout>
<style>
  /* Target EVERY image rendered inside main/section containers on these pages */
  :global(main img),
  :global(section img),
  :global(div img) {
    filter: grayscale(100%) !important;
    transition: filter 0.3s ease-in-out !important;
  }

  /* Reveal full color ONLY when hovering directly over the card or photo */
  :global(main img:hover),
  :global(section img:hover),
  :global(div:hover > img),
  :global(a:hover img) {
    filter: grayscale(0%) !important;
  }

  /* PROTECT NAVBAR: Force header & logo images to stay original color */
  :global(nav img),
  :global(header img),
  :global(.logo img) {
    filter: none !important;
  }
</style>