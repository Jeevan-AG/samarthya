---
import BaseLayout from "../layouts/BaseLayout.astro";
import RevealOnView from "../components/RevealOnView";
import achievements from "../data/achievements.json";

function formatDate(value: string) {
  const [y, m] = value.split("-");
  const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  return `${months[Number(m) - 1]} ${y}`;
}
---

<BaseLayout
  current="/achievements"
  title="Achievements | SAMARTHYA"
  description="Verified milestones from SAMARTHYA competitions, research, and community work."
>
  <section class="relative mx-auto max-w-[1400px] px-5 pb-24 pt-32 lg:px-8">
    <p class="relative font-mono text-[11px] uppercase tracking-[0.32em] text-cyan">Impact log</p>
    <h1 class="relative mt-4 font-display text-6xl md:text-8xl">Achievements</h1>
    <div class="mt-14 grid gap-4 md:grid-cols-2">
      {achievements.map((item, i) => (
        <RevealOnView client:visible delay={i * 50}>
          <article class="hud-border h-full p-7">
            <div class="flex items-center justify-between">
              <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-cyan">{item.category}</span>
              <time class="font-mono text-[10px] text-faint" datetime={item.date}>{formatDate(item.date)}</time>
            </div>
            <h2 class="mt-4 font-display text-3xl leading-none">{item.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-mute">{item.description}</p>
          </article>
        </RevealOnView>
      ))}
    </div>
  </section>
</BaseLayout>
