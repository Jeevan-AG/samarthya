---
import BaseLayout from "../layouts/BaseLayout.astro";
import RevealOnView from "../components/RevealOnView";
import events from "../data/events.json";

function formatDate(value: string) {
  const [y, m, d] = value.split("-");
  const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  return `${months[Number(m) - 1]} ${d}, ${y}`;
}
---

<BaseLayout
  current="/events"
  title="Events | SAMARTHYA"
  description="Workshops, symposiums, and hackathons from SAMARTHYA."
>
  <section class="relative mx-auto max-w-[1400px] px-5 pb-24 pt-32 lg:px-8">
    <p class="relative font-mono text-[11px] uppercase tracking-[0.32em] text-cyan">Technical calendar</p>
    <h1 class="relative mt-4 font-display text-6xl md:text-8xl">Events & workshops</h1>
    <div class="mt-14 grid gap-5 md:grid-cols-2">
      {events.map((event, i) => (
        <RevealOnView client:visible delay={i * 50}>
          <article class="hud-border h-full p-7 rounded-2xl">
            <div class="flex items-center justify-between gap-3">
              <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-cyan">{event.category}</span>
              <span class="font-mono text-[10px] uppercase text-faint">{event.status}</span>
            </div>
            <h2 class="mt-4 font-display text-4xl leading-none">{event.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-mute">{event.description}</p>
            <p class="mt-6 font-mono text-[11px] uppercase tracking-[0.14em] text-paper/70">
              {formatDate(event.date)} · {event.time} · {event.venue}
            </p>
          </article>
        </RevealOnView>
      ))}
    </div>
  </section>
</BaseLayout>
