---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import RevealOnView from "../components/RevealOnView";
import TiltCard from "../components/TiltCard";
import EventModal from "../components/EventModal";
import events from "../data/events.json";

// Import Circuit Craft 1.0 & 2.0 photo assets
const cc2Images = import.meta.glob<{ default: ImageMetadata }>("../assets/pics/events/circuit_craft_2/*.webp", { eager: true });
const cc1Images = import.meta.glob<{ default: ImageMetadata }>("../assets/pics/events/circuit_craft_1/*.webp", { eager: true });

const cc2Photos = Object.values(cc2Images).map((m) => m.default);
const cc1Photos = Object.values(cc1Images).map((m) => m.default);

const allEventsWithPhotos = events.map((event) => {
  if (event.id === "evt-cc-2") {
    return { ...event, photos: cc2Photos.map((p) => p.src) };
  }
  if (event.id === "evt-cc-1") {
    return { ...event, photos: cc1Photos.map((p) => p.src) };
  }
  return event;
});

const flagshipEvents = allEventsWithPhotos.filter((e) => e.featured);
const otherEvents = allEventsWithPhotos.filter((e) => !e.featured);

function formatDate(value: string) {
  const [y, m, d] = value.split("-");
  const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  return `${months[Number(m) - 1]} ${d ? d + ", " : ""}${y}`;
}
---

<BaseLayout
  current="/events"
  title="Circuit Craft & Events | SAMARTHYA"
  description="Explore Circuit Craft 1.0, Circuit Craft 2.0, and technical workshops organized by SAMARTHYA ECE Department Technical Society."
>
  <section class="relative mx-auto max-w-[1440px] px-5 pb-28 pt-32 lg:px-8">
    
    <!-- Header -->
    <div class="relative max-w-3xl mb-16 sm:mb-20">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full font-mono text-[11px] uppercase tracking-[0.24em] bg-cyan/10 text-cyan border border-cyan/25 mb-4">
        <span class="h-2 w-2 rounded-full bg-cyan animate-ping"></span>
        Technical Calendar &amp; Workshops
      </div>
      <h1 class="font-display text-5xl sm:text-7xl lg:text-8xl tracking-tight text-paper">
        Events &amp; Workshops
      </h1>
      <p class="mt-6 text-base sm:text-lg leading-relaxed text-mute">
        Hands-on electronics workshops, PCB fabrication bootcamps, and technical symposiums designed to bridge theoretical classroom concepts with industry-standard hardware engineering.
      </p>
    </div>

    <!-- ═══════════════════════════════════════════
         CIRCUIT CRAFT 2.0
         ═══════════════════════════════════════════ -->
    <div class="mb-24">
      <RevealOnView client:visible>
        <div class="relative rounded-3xl border border-cyan/30 bg-surface/60 backdrop-blur-md p-6 sm:p-10 lg:p-12 overflow-hidden shadow-[0_0_50px_rgba(0,251,248,0.1)]">
          
          <!-- Ambient Background Glow -->
          <div class="pointer-events-none absolute -top-32 -right-32 h-96 w-96 rounded-full bg-cyan/15 blur-[120px]"></div>

          <div class="relative z-10 grid gap-8 lg:grid-cols-12 items-center">
            
            <!-- Left Info Column -->
            <div class="lg:col-span-6 space-y-5">
              <div class="flex flex-wrap items-center gap-3">
                <span class="font-mono text-xs text-cyan tracking-wider uppercase font-semibold">Completed · Sep 2026</span>
              </div>

              <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-paper">
                Circuit Craft 2.0
              </h2>

              <p class="text-sm sm:text-base leading-relaxed text-mute">
                An intensive, hands-on workshop centered on high-density PCB prototyping, surface-mount soldering (SMD), real-time circuit troubleshooting, and microcontroller hardware interfacing. Participants designed, assembled, and verified functioning hardware boards.
              </p>

              <!-- Highlights -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                <div class="flex items-center gap-2.5 rounded-lg bg-white/[0.03] p-3 border border-white/5">
                  <svg class="h-4 w-4 text-cyan shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="font-mono text-xs text-paper/90">Custom PCB Layout Design</span>
                </div>
                <div class="flex items-center gap-2.5 rounded-lg bg-white/[0.03] p-3 border border-white/5">
                  <svg class="h-4 w-4 text-cyan shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="font-mono text-xs text-paper/90">Precision SMD Soldering</span>
                </div>
                <div class="flex items-center gap-2.5 rounded-lg bg-white/[0.03] p-3 border border-white/5">
                  <svg class="h-4 w-4 text-cyan shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="font-mono text-xs text-paper/90">Oscilloscope Signal Debug</span>
                </div>
                <div class="flex items-center gap-2.5 rounded-lg bg-white/[0.03] p-3 border border-white/5">
                  <svg class="h-4 w-4 text-cyan shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="font-mono text-xs text-paper/90">120+ Active Participants</span>
                </div>
              </div>

              <!-- Date Details & Action CTA -->
              <div class="pt-4 border-t border-line/30 flex flex-wrap items-center justify-between gap-4 font-mono text-xs text-paper/70">
                <span>📅 Sep 22, 2026</span>
                <button
                  type="button"
                  data-event-id="evt-cc-2"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-full font-mono text-xs uppercase tracking-wider text-cyan bg-cyan/10 border border-cyan/30 hover:bg-cyan hover:text-void transition-all duration-300 cursor-pointer shadow-[0_0_15px_rgba(0,251,248,0.1)] hover:shadow-[0_0_20px_rgba(0,251,248,0.3)]"
                >
                  <span>Explore Full Dossier &amp; Photos</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Right Photo Grid Column (Clickable to open Gallery Modal) -->
            <div class="lg:col-span-6 grid grid-cols-2 sm:grid-cols-3 gap-3">
              {cc2Photos.slice(0, 6).map((img, idx) => (
                <div
                  data-event-id="evt-cc-2"
                  role="button"
                  tabindex="0"
                  aria-label="View photo in Circuit Craft 2.0 gallery"
                  class={`relative overflow-hidden rounded-xl bg-void aspect-square border border-white/10 group cursor-pointer hover:border-cyan/60 transition-all ${idx === 0 ? "col-span-2 sm:col-span-2 aspect-[16/10]" : ""}`}
                >
                  <Image
                    src={img}
                    alt="Circuit Craft 2.0 workshop moment"
                    width={600}
                    height={400}
                    format="webp"
                    quality={90}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void/60 via-transparent to-transparent opacity-40 group-hover:opacity-10 transition-opacity"></div>
                </div>
              ))}
            </div>

          </div>
        </div>
      </RevealOnView>
    </div>

    <!-- ═══════════════════════════════════════════
         CIRCUIT CRAFT 1.0
         ═══════════════════════════════════════════ -->
    <div id="evt-cc-1" class="mb-28 scroll-mt-24">
      <RevealOnView client:visible>
        <div class="relative rounded-3xl border border-line/60 bg-surface/40 backdrop-blur-md p-6 sm:p-10 lg:p-12 overflow-hidden shadow-2xl">
          
          <div class="relative z-10 grid gap-8 lg:grid-cols-12 items-center">
            
            <!-- Left Photo Grid Column (Clickable to open Gallery Modal) -->
            <div class="lg:col-span-6 order-2 lg:order-1 grid grid-cols-2 sm:grid-cols-3 gap-3">
              {cc1Photos.slice(0, 5).map((img, idx) => (
                <div
                  data-event-id="evt-cc-1"
                  role="button"
                  tabindex="0"
                  aria-label="View photo in Circuit Craft 1.0 gallery"
                  class={`relative overflow-hidden rounded-xl bg-void aspect-square border border-white/10 group cursor-pointer hover:border-cyan/60 transition-all ${idx === 0 ? "col-span-2 aspect-[16/10]" : ""}`}
                >
                  <Image
                    src={img}
                    alt="Circuit Craft 1.0 workshop hands-on session"
                    width={600}
                    height={400}
                    format="webp"
                    quality={90}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void/60 via-transparent to-transparent opacity-40 group-hover:opacity-10 transition-opacity"></div>
                </div>
              ))}
            </div>

            <!-- Right Info Column -->
            <div class="lg:col-span-6 order-1 lg:order-2 space-y-5">
              <div class="flex flex-wrap items-center gap-3">
                <span class="font-mono text-xs text-cyan tracking-wider uppercase font-semibold">Completed · Apr 2026</span>
              </div>

              <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-paper">
                Circuit Craft 1.0
              </h2>

              <p class="text-sm sm:text-base leading-relaxed text-mute">
                The inaugural edition of Circuit Craft establishing the cornerstone of hardware prototyping at SAMARTHYA. Covered analog circuit analysis, digital IC interfacing, breadboard testing, and sensor signal conditioning.
              </p>

              <!-- Highlights -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                <div class="flex items-center gap-2.5 rounded-lg bg-white/[0.03] p-3 border border-white/5">
                  <svg class="h-4 w-4 text-cyan shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="font-mono text-xs text-paper/90">Breadboard Circuit Analysis</span>
                </div>
                <div class="flex items-center gap-2.5 rounded-lg bg-white/[0.03] p-3 border border-white/5">
                  <svg class="h-4 w-4 text-cyan shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="font-mono text-xs text-paper/90">IC & Passive Component Math</span>
                </div>
                <div class="flex items-center gap-2.5 rounded-lg bg-white/[0.03] p-3 border border-white/5">
                  <svg class="h-4 w-4 text-cyan shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="font-mono text-xs text-paper/90">Multi-meter Fault Diagnosis</span>
                </div>
                <div class="flex items-center gap-2.5 rounded-lg bg-white/[0.03] p-3 border border-white/5">
                  <svg class="h-4 w-4 text-cyan shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="font-mono text-xs text-paper/90">Circuit Prototyping Challenges</span>
                </div>
              </div>

              <!-- Date Details & Action CTA -->
              <div class="pt-4 border-t border-line/30 flex flex-wrap items-center justify-between gap-4 font-mono text-xs text-paper/70">
                <span>📅 Apr 10, 2026</span>
                <button
                  type="button"
                  data-event-id="evt-cc-1"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-full font-mono text-xs uppercase tracking-wider text-cyan bg-cyan/10 border border-cyan/30 hover:bg-cyan hover:text-void transition-all duration-300 cursor-pointer shadow-[0_0_15px_rgba(0,251,248,0.1)] hover:shadow-[0_0_20px_rgba(0,251,248,0.3)]"
                >
                  <span>Explore Full Dossier &amp; Photos</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </button>
              </div>
            </div>

          </div>
        </div>
      </RevealOnView>
    </div>

    <!-- ═══════════════════════════════════════════
         UPCOMING & DEPARTMENT CALENDAR
         ═══════════════════════════════════════════ -->
    <div class="relative">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-line/50 pb-5 mb-10">
        <div>
          <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-cyan font-medium">
            Calendar &amp; Symposiums
          </span>
          <h2 class="font-display text-3xl sm:text-4xl text-paper mt-1">
            Department Technical Schedule
          </h2>
        </div>
        <p class="max-w-md text-xs sm:text-sm text-mute leading-relaxed">
          Upcoming hardware hackathons, symposia, and embedded bootcamp sessions. Click any card for full details.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {otherEvents.map((event, i) => (
          <RevealOnView client:visible delay={i * 50}>
            <TiltCard client:visible className="h-full">
              <article
                id={event.id}
                data-event-id={event.id}
                role="button"
                tabindex="0"
                aria-label={`View details for ${event.title}`}
                class="hud-border group relative flex flex-col justify-between h-full p-8 rounded-2xl bg-surface/40 backdrop-blur-sm transition-all duration-300 hover:border-cyan/50 hover:shadow-[0_0_25px_rgba(0,251,248,0.15)] hover:-translate-y-1.5 overflow-hidden cursor-pointer"
              >
                
                <div class="relative z-10">
                  <div class="flex items-center justify-between gap-3 mb-4">
                    <span class="font-mono text-[10.5px] uppercase tracking-[0.18em] px-2.5 py-1 rounded-full bg-cyan/10 text-cyan border border-cyan/25">
                      {event.category}
                    </span>
                    <span class={`font-mono text-[10.5px] uppercase tracking-wider ${event.status === 'upcoming' ? 'text-cyan font-semibold flex items-center gap-1.5' : 'text-faint'}`}>
                      {event.status === 'upcoming' && <span class="h-1.5 w-1.5 rounded-full bg-cyan animate-pulse"></span>}
                      {event.status}
                    </span>
                  </div>

                  <h3 class="font-display text-3xl text-paper transition-colors duration-300 group-hover:text-cyan">
                    {event.title}
                  </h3>

                  {event.subtitle && (
                    <p class="mt-1 font-mono text-xs text-paper/70">
                      {event.subtitle}
                    </p>
                  )}

                  <p class="mt-4 text-sm leading-relaxed text-mute">
                    {event.description}
                  </p>

                  {event.highlights && (
                    <div class="mt-4 flex flex-wrap gap-2">
                      {event.highlights.map((h: string) => (
                        <span class="font-mono text-[10px] px-2 py-1 rounded bg-white/[0.04] text-paper/70 border border-white/5">
                          {h}
                        </span>
                      ))}
                    </div>
                  )}
                </div>

                <div class="relative z-10 mt-6 pt-4 border-t border-line/30">
                  <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-[11px] text-faint">
                    <span>📅 {formatDate(event.date)}</span>
                    <span>{event.venue}</span>
                  </div>

                  <!-- Click Affordance CTA -->
                  <div class="mt-3 flex items-center justify-between text-xs font-mono text-cyan/80 group-hover:text-cyan font-medium pt-2 border-t border-white/5">
                    <span class="inline-flex items-center gap-1.5">
                      <span class="h-1.5 w-1.5 rounded-full bg-cyan/60 group-hover:bg-cyan group-hover:animate-ping"></span>
                      Click to open full dossier
                    </span>
                    <span class="transform transition-transform duration-300 group-hover:translate-x-1 font-mono">→</span>
                  </div>
                </div>

              </article>
            </TiltCard>
          </RevealOnView>
        ))}
      </div>
    </div>

    <!-- Event Details & Gallery Modal -->
    <EventModal client:load events={allEventsWithPhotos} />

  </section>
</BaseLayout>
