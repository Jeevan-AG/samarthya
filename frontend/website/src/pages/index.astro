---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroScene3D from "../components/HeroScene3D";
import RevealOnView from "../components/RevealOnView";
import TiltCard from "../components/TiltCard";
import AboutCollage from "../components/AboutCollage.astro";
import ParallaxGallery from "../components/ParallaxGallery.astro";
import TypewriterText from "../components/TypewriterText";
import ScrambleText from "../components/ScrambleText";
import GlitchText from "../components/GlitchText";
import faculty from "../data/faculty.json";
import team from "../data/team.json";
import events from "../data/events.json";

// Import all team and faculty portrait images
const teamImages = import.meta.glob<{ default: ImageMetadata }>("../assets/pics/team/*.webp", { eager: true });
const facultyImages = import.meta.glob<{ default: ImageMetadata }>("../assets/pics/faculty/*.webp", { eager: true });
// Import Circuit Craft images for homepage preview
const cc2Images = import.meta.glob<{ default: ImageMetadata }>("../assets/pics/events/circuit_craft_2/*.webp", { eager: true });
const cc1Images = import.meta.glob<{ default: ImageMetadata }>("../assets/pics/events/circuit_craft_1/*.webp", { eager: true });

const cc2Photos = Object.values(cc2Images).map((m) => m.default);
const cc1Photos = Object.values(cc1Images).map((m) => m.default);

// Feature key leadership and leads on homepage grid
const featuredTeam = team.slice(0, 8);
const featuredEvents = events.slice(0, 3);

function formatDate(value: string) {
  const [y, m, d] = value.split("-");
  const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  return `${months[Number(m) - 1]} ${d ? d + ", " : ""}${y}`;
}
---

<BaseLayout
  current="/"
  title="SAMARTHYA"
  description="Official technical club of the Electronics and Communication Engineering Department — hardware labs, Circuit Craft workshops, and student-built systems."
>
  <!-- ═══════════════════════════════════════════
       HERO SCREEN (Centered 3D Core with Reference HUD Layout)
       ═══════════════════════════════════════════ -->
  <section class="relative isolate min-h-[100dvh] flex items-center justify-center overflow-hidden pt-24 lg:pt-28 pb-16 lg:pb-20" aria-label="Hero">
    <h1 class="sr-only">SAMARTHYA — Where Ideas Become Reality</h1>

    <!-- Ambient central glow aura behind the 3D core -->
    <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center">
      <div class="h-[450px] w-[450px] sm:h-[600px] sm:w-[600px] lg:h-[700px] lg:w-[700px] rounded-full bg-gradient-to-tr from-cyan/20 via-sky-500/15 to-transparent blur-[120px] opacity-70 animate-pulse" style="animation-duration: 6s;"></div>
    </div>

    <!-- Main Container: Wide Canvas for Perfect 3-Column Balance -->
    <div class="relative z-10 mx-auto w-full max-w-[1560px] px-6 sm:px-10 lg:px-16 py-6">
      
      <!-- Upper / Desktop Grid Overlay matching reference positioning -->
      <div class="relative min-h-[600px] sm:min-h-[660px] lg:min-h-[720px] flex flex-col justify-center">

        <!-- ═════════════════════════════════════════════
             3D CORE (Elevated & shifted aside)
             ═════════════════════════════════════════════ -->
        <div class="lg:absolute inset-0 flex items-center justify-center pointer-events-none z-0 -translate-y-8 sm:-translate-y-12 lg:-translate-y-20 translate-x-4 sm:translate-x-8 lg:translate-x-16 xl:translate-x-24">
          <div class="relative w-full max-w-[560px] sm:max-w-[640px] lg:max-w-[720px] aspect-square flex items-center justify-center pointer-events-auto">
            <!-- 3D Interactive Model Canvas -->
            <HeroScene3D client:only="react" className="relative z-10 h-full w-full" />
          </div>
        </div>

        <!-- ═════════════════════════════════════════════
             MID-LEFT & BOTTOM-RIGHT FLOATING CONTENT
             ═════════════════════════════════════════════ -->
        <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 items-stretch min-h-[560px] sm:min-h-[600px] lg:min-h-[660px] gap-8 pt-4 lg:pt-0">
          
          <!-- Left Column: Top aligns with the 3D Black Disc -->
          <div class="lg:col-span-4 flex flex-col justify-start items-start text-left pt-3 sm:pt-4 lg:pt-8">
            <!-- Left Edge Label: "SAMARTHYA is" with line -->
            <div class="flex items-center gap-3 mb-5">
              <span class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-white/70 uppercase">
                SAMARTHYA is
              </span>
              <div class="h-px w-10 sm:w-16 bg-gradient-to-r from-white/40 to-transparent"></div>
            </div>

            <!-- Traits Stack -->
            <div class="space-y-1 sm:space-y-1.5 text-left font-sans normal-case">
              <p class="text-3xl sm:text-4xl lg:text-[3.25rem] font-extrabold tracking-tight text-white leading-[1.12]">
                Innovation,
              </p>
              <p class="text-3xl sm:text-4xl lg:text-[3.25rem] font-extrabold tracking-tight text-white leading-[1.12]">
                Research, Impact,
              </p>
              <p class="text-3xl sm:text-4xl lg:text-[3.25rem] font-extrabold tracking-tight text-cyan leading-[1.12] drop-shadow-[0_0_20px_rgba(0,251,248,0.3)]">
                Accessible
              </p>
            </div>

            <!-- Action buttons -->
            <div class="mt-8 flex flex-wrap items-center gap-3.5">
              <a
                href="/events"
                class="group inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-sm font-semibold text-void bg-white hover:bg-cyan hover:shadow-[0_0_24px_rgba(0,251,248,0.45)] transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0"
              >
                <span>Events</span>
                <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                </svg>
              </a>
              <a
                href="/team"
                class="inline-flex items-center justify-center px-6 py-3 rounded-full text-sm font-medium text-paper bg-white/[0.06] hover:bg-white/[0.12] border border-white/15 hover:border-cyan/40 hover:text-white transition-all duration-200 backdrop-blur-md"
              >
                <span>Core Team</span>
              </a>
            </div>
          </div>

          <!-- Empty Right Column spacer to balance grid -->
          <div class="hidden lg:block lg:col-span-8 pointer-events-none"></div>

        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       01 — ABOUT SAMARTHYA
       ═══════════════════════════════════════════ -->
  <section id="about" class="relative pt-12 lg:pt-16 pb-20 lg:pb-28 scroll-mt-28" aria-label="About SAMARTHYA">
    <div class="mx-auto max-w-[1400px] px-5 lg:px-8">
      <div class="grid items-start gap-10 lg:gap-14 lg:grid-cols-12 -translate-y-3 lg:-translate-y-6">
        
        <!-- Left: Mission & Details -->
        <div class="lg:col-span-6 flex flex-col justify-start pt-1">
          <RevealOnView client:visible>
            <div class="mb-4">
              <TypewriterText client:visible text="// about" />
            </div>
            <p class="mt-6 text-base sm:text-lg leading-relaxed text-mute">
              The Samarthya Club is the official technical society of the Electronics and Communication Engineering Department, dedicated to enhancing students' technical skills, promoting project-based learning, and cultivating leadership qualities. The club actively engages in cutting-edge domains such as embedded systems, image processing, and biomedical applications, with an emphasis on social innovation. By organizing workshops, seminars, and hands-on projects, Samarthya provides students with practical experience, bridging theoretical knowledge with real-world engineering applications.
            </p>
            <p class="mt-4 text-base sm:text-lg leading-relaxed text-mute">
              Collaborative projects encourage teamwork, innovative thinking, and problem-solving skills, preparing members for competitive industry challenges. The club's focus on social innovation ensures that technological advancements address societal needs, fostering responsibility among students. Through these initiatives, Samarthya equips members with technical proficiency, leadership, and ethical values, ensuring complete readiness for professional endeavors.
            </p>
          </RevealOnView>
        </div>

        <!-- Right: Scattered Photo Collage Showcase (with 2 new photos) -->
        <div class="lg:col-span-6">
          <RevealOnView client:visible delay={120}>
            <AboutCollage />
          </RevealOnView>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       02 — FACULTY CO-ORDINATORS
       ═══════════════════════════════════════════ -->
  <section id="faculty" class="relative py-24 lg:py-32 scroll-mt-20" aria-label="Faculty Coordinators">
    <div class="mx-auto max-w-[1400px] px-5 lg:px-8">
      
      <!-- Section Header -->
      <div class="mb-14">
        <RevealOnView client:visible>
          <div class="mb-4">
            <TypewriterText client:visible text="faculty co-ordinators" speed={35} delay={60} />
          </div>
        </RevealOnView>
      </div>

      <!-- Faculty Cards Grid (Website1 Style - Centered for 2 Coordinators) -->
      <div class="mx-auto max-w-4xl grid gap-8 sm:grid-cols-2">
        {faculty.map((member, i) => {
          const imageKey = `../assets/pics/faculty/${member.image}`;
          const imgMetadata = member.image ? facultyImages[imageKey]?.default : null;

          return (
            <RevealOnView client:visible delay={i * 100}>
              <TiltCard client:visible className="h-full">
                <article class="group relative flex flex-col justify-between h-full rounded-2xl border border-line bg-surface/50 backdrop-blur-md overflow-hidden transition-all duration-300 hover:border-cyan/50 hover:shadow-[0_12px_30px_rgba(0,0,0,0.6),0_0_24px_rgba(0,251,248,0.15)] hover:-translate-y-1.5">
                  
                  <!-- Top Image Frame -->
                  <div class="relative aspect-square w-full overflow-hidden bg-void border-b border-line/30">
                    {imgMetadata ? (
                      <Image
                        src={imgMetadata}
                        alt={`Portrait of ${member.name}`}
                        width={500}
                        height={500}
                        format="webp"
                        quality={88}
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover object-top brightness-[0.95] contrast-[1.03] transition-transform duration-700 ease-out group-hover:scale-108 group-hover:brightness-105"
                      />
                    ) : (
                      <div class="flex h-full w-full items-center justify-center bg-panel font-mono text-xs text-faint">
                        [FACULTY]
                      </div>
                    )}
                    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-85 group-hover:opacity-40 transition-opacity duration-300"></div>
                  </div>

                  <!-- Info Container -->
                  <div class="p-5 flex flex-col justify-between flex-1">
                    <div>
                      <h3 class="font-display text-xl sm:text-2xl text-paper transition-colors duration-300 group-hover:text-cyan line-clamp-1">
                        {member.name}
                      </h3>
                      <p class="mt-1 font-mono text-[11px] uppercase tracking-[0.14em] text-cyan/90 font-medium">
                        {member.designation} · {member.department || "ECE Dept"}
                      </p>
                    </div>

                    <div class="mt-5 pt-3 border-t border-line/30 flex items-center justify-between font-mono text-[10px] text-faint">
                      <span class="uppercase tracking-wider">SAMARTHYA · SJEC</span>
                      {member.linkedin ? (
                        <a
                          href={member.linkedin}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-mute hover:text-cyan hover:scale-115 transition-all p-1"
                          aria-label={`${member.name}'s LinkedIn`}
                        >
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                            <rect x="2" y="9" width="4" height="12" rx="0.5" />
                            <circle cx="4" cy="4" r="2" />
                          </svg>
                        </a>
                      ) : (
                        <span class="text-cyan/70">SJEC ECE</span>
                      )}
                    </div>
                  </div>

                  <!-- Bottom Accent Bar from Website1 -->
                  <div class="absolute bottom-0 left-0 right-0 h-[2.5px] bg-cyan scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left" />

                </article>
              </TiltCard>
            </RevealOnView>
          );
        })}
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       03 — CORE TEAM & OFFICE BEARERS
       ═══════════════════════════════════════════ -->
  <section id="team" class="relative py-24 lg:py-32 scroll-mt-20" aria-label="Student Leadership Team">
    <div class="mx-auto max-w-[1400px] px-5 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-14">
        <div>
          <RevealOnView client:visible>
            <div class="mb-4">
              <ScrambleText client:visible text="core team" />
            </div>
            <p class="font-mono text-xs text-faint uppercase tracking-widest mt-1">Student Office Bearers &amp; Leads</p>
          </RevealOnView>
        </div>
        
        <RevealOnView client:visible delay={100}>
          <a
            href="/team"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full font-mono text-xs uppercase tracking-wider text-cyan bg-cyan/10 border border-cyan/30 hover:bg-cyan hover:text-void transition-all duration-300"
          >
            <span>View All Office Bearers</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </RevealOnView>
      </div>

      <!-- Team Members Grid (Website1 Style) -->
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {featuredTeam.map((member, i) => {
          const imageKey = `../assets/pics/team/${member.image}`;
          const imgMetadata = teamImages[imageKey]?.default;

          return (
            <RevealOnView client:visible delay={i * 45}>
              <TiltCard client:visible className="h-full">
                <article class="group relative flex flex-col justify-between h-full rounded-2xl border border-line bg-surface/50 backdrop-blur-md overflow-hidden transition-all duration-300 hover:border-cyan/50 hover:shadow-[0_12px_30px_rgba(0,0,0,0.6),0_0_24px_rgba(0,251,248,0.15)] hover:-translate-y-1.5">
                  
                  <!-- Aspect Square Image Frame with Zoom & Overlay -->
                  <div class="relative aspect-square w-full overflow-hidden bg-void/80 border-b border-line/40">
                    {imgMetadata ? (
                      <Image
                        src={imgMetadata}
                        alt={`Portrait of ${member.name}`}
                        width={500}
                        height={500}
                        format="webp"
                        quality={88}
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover object-top brightness-[0.95] contrast-[1.03] transition-transform duration-700 ease-out group-hover:scale-108 group-hover:brightness-105"
                      />
                    ) : (
                      <div class="flex h-full w-full items-center justify-center bg-panel font-mono text-xs text-faint">
                        [PHOTO]
                      </div>
                    )}
                    
                    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-80 group-hover:opacity-40 transition-opacity duration-300"></div>
                  </div>

                  <!-- Info Container -->
                  <div class="p-5 flex flex-col justify-between flex-1">
                    <div>
                      <h3 class="font-display text-xl sm:text-2xl text-paper transition-colors duration-300 group-hover:text-cyan line-clamp-1">
                        {member.name}
                      </h3>

                      {member.role && (
                        <p class="mt-1 font-mono text-[11px] uppercase tracking-[0.14em] text-cyan/90 font-medium line-clamp-1">
                          {member.role}
                        </p>
                      )}
                    </div>

                    <!-- Bottom Tag + LinkedIn Icon -->
                    <div class="mt-5 pt-3 border-t border-line/30 flex items-center justify-between font-mono text-[10px] text-faint">
                      <span class="uppercase tracking-wider">SAMARTHYA · SJEC</span>
                      <a
                        href={member.linkedin || "https://www.linkedin.com/"}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-mute hover:text-cyan hover:scale-115 transition-all p-1"
                        aria-label={`${member.name}'s LinkedIn`}
                      >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                          <rect x="2" y="9" width="4" height="12" rx="0.5" />
                          <circle cx="4" cy="4" r="2" />
                        </svg>
                      </a>
                    </div>
                  </div>

                  <!-- Bottom Accent Bar from Website1 -->
                  <div class="absolute bottom-0 left-0 right-0 h-[2.5px] bg-cyan scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left" />

                </article>
              </TiltCard>
            </RevealOnView>
          );
        })}
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       04 — CIRCUIT CRAFT & EVENTS
       ═══════════════════════════════════════════ -->
  <section id="events" class="relative py-24 lg:py-32 scroll-mt-20" aria-label="Circuit Craft Workshops">
    <div class="mx-auto max-w-[1400px] px-5 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-14">
        <div>
          <RevealOnView client:visible>
            <div class="mb-4">
              <GlitchText client:visible text="events" highlightWord="" />
            </div>
            <p class="font-mono text-xs text-faint uppercase tracking-widest mt-1">Technical Workshops &amp; Prototyping</p>
          </RevealOnView>
        </div>

        <RevealOnView client:visible delay={100}>
          <a
            href="/events"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full font-mono text-xs uppercase tracking-wider text-cyan bg-cyan/10 border border-cyan/30 hover:bg-cyan hover:text-void transition-all duration-300"
          >
            <span>Explore All Events</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </RevealOnView>
      </div>

      <!-- Events Showcase Grid (Centered 2-Card Layout) -->
      <div class="mx-auto max-w-4xl grid gap-8 sm:grid-cols-2">
        
        <!-- Card 1: Circuit Craft 2.0 -->
        <RevealOnView client:visible delay={0}>
          <TiltCard client:visible className="h-full">
            <article class="group relative flex h-full flex-col justify-between rounded-2xl border border-cyan/40 bg-surface/50 p-6 transition-all duration-300 hover:border-cyan hover:shadow-[0_0_24px_rgba(0,251,248,0.2)] hover:-translate-y-1.5 overflow-hidden">
              
              <div class="relative z-10">
                <!-- Event Photo Preview -->
                {cc2Photos[0] && (
                  <div class="relative mb-4 overflow-hidden rounded-xl bg-void aspect-[16/10] border border-white/10">
                    <Image
                      src={cc2Photos[0]}
                      alt="Circuit Craft 2.0 Hardware Workshop"
                      width={500}
                      height={312}
                      format="webp"
                      quality={88}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void/70 via-transparent to-transparent"></div>
                  </div>
                )}

                <h3 class="font-display text-2xl sm:text-3xl leading-tight text-paper group-hover:text-cyan transition-colors duration-300">
                  Circuit Craft 2.0
                </h3>
                <p class="mt-2.5 text-sm leading-relaxed text-mute">
                  Advanced PCB prototyping, surface-mount soldering, and live oscilloscope signal analysis.
                </p>
              </div>

              <div class="relative z-10 mt-6 pt-4 border-t border-line/30 flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.16em] text-paper/85">
                <span>Sep 22, 2026</span>
                <span class="text-cyan">10:00 AM</span>
              </div>
            </article>
          </TiltCard>
        </RevealOnView>

        <!-- Card 2: Circuit Craft 1.0 -->
        <RevealOnView client:visible delay={70}>
          <TiltCard client:visible className="h-full">
            <article class="group relative flex h-full flex-col justify-between rounded-2xl border border-line bg-surface/40 p-6 transition-all duration-300 hover:border-cyan/40 hover:shadow-[0_0_20px_rgba(0,251,248,0.1)] hover:-translate-y-1.5 overflow-hidden">
              
              <div class="relative z-10">
                {cc1Photos[0] && (
                  <div class="relative mb-4 overflow-hidden rounded-xl bg-void aspect-[16/10] border border-white/10">
                    <Image
                      src={cc1Photos[0]}
                      alt="Circuit Craft 1.0 Workshop"
                      width={500}
                      height={312}
                      format="webp"
                      quality={88}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void/70 via-transparent to-transparent"></div>
                  </div>
                )}

                <h3 class="font-display text-2xl sm:text-3xl leading-tight text-paper group-hover:text-cyan transition-colors duration-300">
                  Circuit Craft 1.0
                </h3>
                <p class="mt-2.5 text-sm leading-relaxed text-mute">
                  Fundamentals of electronic hardware engineering, breadboard prototyping, and component diagnostics.
                </p>
              </div>

              <div class="relative z-10 mt-6 pt-4 border-t border-line/30 flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.16em] text-paper/85">
                <span>Apr 10, 2026</span>
                <span class="text-cyan">9:30 AM</span>
              </div>
            </article>
          </TiltCard>
        </RevealOnView>

      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       05 — PARALLAX PHOTO STREAM
       ═══════════════════════════════════════════ -->
  <section class="relative py-16 lg:py-24 overflow-hidden" aria-label="Workshop Highlights">
    <div class="mx-auto max-w-[1560px] px-4 sm:px-6 lg:px-8">
      <RevealOnView client:visible delay={50}>
        <ParallaxGallery />
      </RevealOnView>
    </div>
  </section>
</BaseLayout>
