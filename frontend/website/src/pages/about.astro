---
import BaseLayout from "../layouts/BaseLayout.astro";
import RevealOnView from "../components/RevealOnView";

const milestones = [
  { year: "2021", title: "Foundation", copy: "ECE students opened a platform for hardware that coursework never quite reached." },
  { year: "2022", title: "TechVista", copy: "First symposium. Paper tracks, project floors, and 300+ students in the hall." },
  { year: "2023", title: "National stage", copy: "SIH qualification and a run of inter-college wins." },
  { year: "2024", title: "Workshop year", copy: "PCB, IoT, VLSI, embedded — 500+ students through the series." },
  { year: "2025", title: "Industry links", copy: "Internships, guest benches, and project guidance from partners." },
  { year: "2026", title: "Still soldering", copy: "Alumni net, research incubation, and a louder calendar." },
];
---

<BaseLayout
  current="/about"
  title="About | SAMARTHYA"
  description="Mission, vision, and history of SAMARTHYA, the ECE department technical club."
>
  <section class="relative mx-auto max-w-[1400px] px-5 pb-24 pt-32 lg:px-8">
    <p class="relative font-mono text-[11px] uppercase tracking-[0.32em] text-cyan">Club brief</p>
    <h1 class="relative mt-4 max-w-4xl font-display text-6xl leading-[0.88] md:text-8xl">
      Flagship technical club of ECE.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-mute">
      We exist so students leave with a portfolio, not only a transcript — boards, firmware, papers,
      and teams that have already been tested.
    </p>

    <div class="mt-16 grid gap-6 md:grid-cols-2">
      <RevealOnView client:visible>
        <article class="hud-border p-8">
          <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-cyan">Mission</p>
          <h2 class="mt-3 font-display text-4xl">Bridge theory and practice</h2>
          <p class="mt-4 text-sm leading-relaxed text-mute">
            An ecosystem for emerging electronics: workshops, projects, and competitions where the
            best learning still happens by hand.
          </p>
        </article>
      </RevealOnView>
      <RevealOnView client:visible delay={80}>
        <article class="hud-border p-8">
          <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-cyan">Vision</p>
          <h2 class="mt-3 font-display text-4xl">Shape future inventors</h2>
          <p class="mt-4 text-sm leading-relaxed text-mute">
            Industry-ready engineers who can think, collaborate, and ship. Every member leaves with
            proof of work.
          </p>
        </article>
      </RevealOnView>
    </div>

    <ol class="mt-20 space-y-8 border-l border-line pl-8">
      {milestones.map((item, i) => (
        <li>
          <RevealOnView client:visible delay={i * 40}>
            <p class="font-mono text-[11px] text-cyan">{item.year}</p>
            <h3 class="mt-1 font-display text-3xl">{item.title}</h3>
            <p class="mt-2 max-w-xl text-sm text-mute">{item.copy}</p>
          </RevealOnView>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
