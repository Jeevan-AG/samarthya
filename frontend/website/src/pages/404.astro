---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found | SAMARTHYA" description="This page is off the grid.">
  <section class="mx-auto flex min-h-[70dvh] max-w-[900px] flex-col justify-center px-5 pt-28 lg:px-8">
    <p class="font-mono text-[11px] uppercase tracking-[0.32em] text-cyan">404</p>
    <h1 class="mt-4 font-display text-6xl md:text-8xl">Signal lost.</h1>
    <p class="mt-4 text-mute">That route is not on the SAMARTHYA map.</p>
    <a href="/" class="btn-primary mt-8 w-fit">Return to home</a>
  </section>
</BaseLayout>
