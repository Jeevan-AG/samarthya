---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import RevealOnView from "../components/RevealOnView";
import TiltCard from "../components/TiltCard";
import faculty from "../data/faculty.json";

const facultyImages = import.meta.glob<{ default: ImageMetadata }>("../assets/pics/faculty/*.webp", { eager: true });
---

<BaseLayout
  current="/faculty"
  title="Faculty Coordinators | SAMARTHYA"
  description="Faculty coordinators and academic mentors guiding the SAMARTHYA ECE technical society."
>
  <section class="relative mx-auto max-w-[1440px] px-5 pb-28 pt-32 lg:px-8">
    
    <!-- Hero Header -->
    <div class="relative max-w-3xl mb-16 sm:mb-20">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full font-mono text-[11px] uppercase tracking-[0.24em] bg-cyan/10 text-cyan border border-cyan/25 mb-4">
        <span class="h-2 w-2 rounded-full bg-cyan animate-pulse"></span>
        Department Advisory &amp; Mentorship
      </div>
      <h1 class="font-display text-5xl sm:text-7xl lg:text-8xl tracking-tight text-paper">
        Faculty Coordinators
      </h1>
      <p class="mt-6 text-base sm:text-lg leading-relaxed text-mute">
        The guiding forces behind SAMARTHYA — experienced academicians and mentors who inspire, guide, and drive our technical vision forward.
      </p>
    </div>

    <!-- Faculty Cards Stack (Website1 Style) -->
    <div class="space-y-12 lg:space-y-16">
      {faculty.map((member, i) => {
        const imageKey = `../assets/pics/faculty/${member.image}`;
        const imgMetadata = member.image ? facultyImages[imageKey]?.default : null;

        return (
          <RevealOnView client:visible delay={i * 90}>
            <div class="group relative rounded-3xl border border-line bg-surface/50 backdrop-blur-md overflow-hidden shadow-2xl transition-all duration-300 hover:border-cyan/50 hover:shadow-[0_16px_40px_rgba(0,0,0,0.7),0_0_30px_rgba(0,251,248,0.12)] hover:-translate-y-1">
              
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 items-stretch">
                
                <!-- Left Image Column -->
                <div class="lg:col-span-4 relative bg-void min-h-[280px] sm:min-h-[340px] lg:min-h-[420px] overflow-hidden">
                  {imgMetadata ? (
                    <Image
                      src={imgMetadata}
                      alt={`Portrait of ${member.name}`}
                      width={600}
                      height={700}
                      format="webp"
                      quality={90}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover object-top brightness-[0.95] contrast-[1.03] transition-transform duration-700 ease-out group-hover:scale-105 group-hover:brightness-105"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-panel font-mono text-sm text-faint">
                      [FACULTY PORTRAIT]
                    </div>
                  )}

                  <!-- Gradient overlay blending into content card -->
                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent lg:bg-gradient-to-r lg:from-transparent lg:via-transparent lg:to-surface opacity-90 lg:opacity-75"></div>

                  <!-- Role badge -->
                  <div class="absolute top-4 left-4 z-10">
                    <span class="inline-flex items-center px-3 py-1 rounded-full font-mono text-[10.5px] uppercase tracking-[0.16em] bg-void/90 text-cyan border border-cyan/30 backdrop-blur-md shadow-lg">
                      {member.role || "Faculty Coordinator"}
                    </span>
                  </div>
                </div>

                <!-- Right Info Column -->
                <div class="lg:col-span-8 p-7 sm:p-10 lg:p-12 flex flex-col justify-center">
                  <span class="font-mono text-xs tracking-[0.2em] uppercase text-cyan mb-2 block font-semibold">
                    {member.specialization}
                  </span>

                  <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-paper mb-2 group-hover:text-cyan transition-colors duration-300">
                    {member.name}
                  </h2>

                  <p class="font-mono text-xs sm:text-sm text-cyan/90 uppercase tracking-wider mb-6">
                    {member.designation} · {member.department}
                  </p>

                  <p class="text-sm sm:text-base text-mute leading-relaxed mb-8">
                    {member.bio}
                  </p>

                  <!-- Qualifications Pills -->
                  {member.qualifications && (
                    <div class="mb-8">
                      <h3 class="font-mono text-xs font-semibold tracking-widest uppercase text-faint mb-3">
                        Qualifications &amp; Roles
                      </h3>
                      <div class="flex flex-wrap gap-2">
                        {member.qualifications.map((q: string) => (
                          <span class="font-mono text-xs px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/10 text-paper/85 group-hover:border-cyan/20 transition-colors">
                            {q}
                          </span>
                        ))}
                      </div>
                    </div>
                  )}

                  <!-- Contact Info Icons -->
                  <div class="flex flex-wrap gap-6 text-xs sm:text-sm font-mono text-faint pt-4 border-t border-line/30">
                    {member.email && (
                      <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <rect x="2" y="4" width="20" height="16" rx="2" stroke-width="2" />
                          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" stroke-width="2" />
                        </svg>
                        <a href={`mailto:${member.email}`} class="text-paper/80 hover:text-cyan transition-colors">
                          {member.email}
                        </a>
                      </div>
                    )}
                    {member.office && (
                      <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        <span class="text-paper/80">{member.office}</span>
                      </div>
                    )}
                  </div>
                </div>

              </div>

              <!-- Bottom Accent Bar from Website1 -->
              <div class="absolute bottom-0 left-0 right-0 h-[2.5px] bg-cyan scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left" />

            </div>
          </RevealOnView>
        );
      })}
    </div>

  </section>
</BaseLayout>
<style>
  /* Target EVERY image rendered inside main/section containers on these pages */
  :global(main img),
  :global(section img),
  :global(div img) {
    filter: grayscale(100%) !important;
    transition: filter 0.3s ease-in-out !important;
  }

  /* Reveal full color ONLY when hovering directly over the card or photo */
  :global(main img:hover),
  :global(section img:hover),
  :global(div:hover > img),
  :global(a:hover img) {
    filter: grayscale(0%) !important;
  }

  /* PROTECT NAVBAR: Force header & logo images to stay original color */
  :global(nav img),
  :global(header img),
  :global(.logo img) {
    filter: none !important;
  }
</style>